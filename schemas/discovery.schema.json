{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "FF6 Discovery",
  "required": [
    "schema_version",
    "id",
    "claim",
    "observations",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "observations": {
      "type": "array"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "strong-hypothesis",
        "tentative-hypothesis",
        "unknown"
      ]
    }
  }
}