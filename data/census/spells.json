{
  "schema_version": "1.0",
  "domain": "MAGIC",
  "description": "Global spell/ability records. Established by EXP-0026: the $C46AC0 14-byte record table (CEN-BATTLE-0004) doubles as the spell database \u2014 records 0-53 are the 54 magic spells (count Confirmed by the name-table boundary, EXP-0027), ids shared with the 7-byte name table at ROMFILE:0x26F567 (CEN-MAGIC-0003). Names decode via the fixed-font byte encoding (CEN-MENU-0006). Bulk name text stays in local artifacts per docs/legal/ASSET_POLICY.md; this inventory stores ids, offsets, numbers, flags, and observation-sourced display names only.",
  "expected_record_count": 54,
  "structure": {
    "data_records": {
      "rom_file_offset": "0x046AC0 + 14*id",
      "record_size": 14,
      "fields": {
        "byte1": "element mask (Confirmed, EXP-0010/0019)",
        "byte2": "flags: bit0 physical formula, bit7 MP-path dispatch (Confirmed)",
        "byte3": "bit7 MP retarget (Confirmed); other bits unknown",
        "byte4": "mode: bit7 base variant, bit1 flip chain, bit0 party halving (Confirmed)",
        "byte5": "MP cost (Confirmed for id 45: menu readout + '5 MP Needed' targeting text + live deduction 24->19, EXP-0026/0027; other ids extracted, per-id on-screen verification pending)",
        "byte6": "power (Confirmed, EXP-0014/0015)",
        "byte9": "flag byte, ASL post-processed (Confirmed loader-side; semantics unknown)",
        "byte10": "abort bits #$82 (partial, EXP-0010)",
        "bytes_0_7_8_11_12_13": "unknown"
      }
    },
    "name_records": {
      "rom_file_offset": "0x26F567 + 7*id",
      "record_size": 7,
      "layout": "[class icon byte][6-char name, fixed-font encoding]"
    },
    "availability": {
      "wram": "+$1A6E + 54*character_slot (54 bytes per character, $FF = known; stride beyond slot 0 is a hypothesis)"
    }
  },
